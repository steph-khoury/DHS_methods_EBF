#delimit cr;


*************************************************
* Loop through data files to extract variables
* specificed in variable selection DO file
**************************************************

foreach x of local survey_list {
local y = `y' +1
dis "`x'"
use `x', clear
do "$root/01_data_preparation/01a_KR_variable_selection_22_June_2026.do"

_getfilename `x'
gen str12 survey_code = r(filename)
label drop _all

save f`y'.dta, replace 
}


************************
** Append all files
*************************

use f1.dta,clear
erase f1.dta

forvalues i=2/331 {
append using f`i'.dta
dis "Appending survey number `i' of 331"
drop if survey_code==""
erase f`i'.dta
}

************************
* Add country codes
************************

do "$root/01_data_preparation/01b_KR_country_codes_29_Sept_2021.do"
tab survey_code if country_name==""
drop if country_name=="" // no survey dropped here


** Fix survey years

bysort survey_code: egen survey_year = min(v007)
replace survey_year = survey_year + 1900 if survey_year < 100 // 2 digit format
replace survey_year = 2000 if survey_year==1900 // 2000 case
 
 // Ethiopia
 
replace survey_year=2000 if survey_code=="ETKR41FL.DTA"
replace survey_year=2005 if survey_code=="ETKR51FL.DTA"
replace survey_year=2011 if survey_code=="ETKR61FL.DTA"
replace survey_year=2016 if survey_code=="ETKR70FL.DTA"
 
 // Nepal
 
 
replace survey_year=1996 if survey_code=="NPKR31FL.DTA"
replace survey_year=2001 if survey_code=="NPKR41FL.DTA"
replace survey_year=2006 if survey_code=="NPKR51FL.DTA"
replace survey_year=2011 if survey_code=="NPKR61FL.DTA" 
replace survey_year=2016 if survey_code=="NPKR7HFL.DTA"
replace survey_year=2022 if survey_code=="NPKR82FL.DTA"


order country country_name survey_year survey_code

// Afghanistan 
replace survey_year=2015 if survey_code=="AFKR71FL.DTA"

//Vietnam 

replace survey_year = 2002 if survey_year ==1902

*compress

// Add additonal labels

label var country "Numeric country code"
label var country_name "Country name"
label var survey_year "Year of survey"
label var survey_code "Survey code"
label var v190 "Wealth quintile"

label var dhscc "DHS country code"

order country_name survey_year survey_code 
drop country


label data "DHS KR file 22 Jun 2026"
save "$root/data/restricted/wf_breastfeeding_dhs_22Jun2026.dta", replace
